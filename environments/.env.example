# Copy this file to environments/.env and fill in real values.
# playwright.config.ts loads environments/.env automatically.

# --- Notes app under test ---
# Scheme + host of the instance under test, no port. The API/app URL (:4444)
# and MailHog URL (:8025) are derived from it. Defaults to the deployed instance.
TEST_HOST=http://ec2-18-220-190-172.us-east-2.compute.amazonaws.com
# --- Dedicated test accounts (provisioned automatically on first run) ---
ACCOUNT_A_EMAIL=aqa-account-a@example.com
ACCOUNT_A_PASSWORD=Passw0rd123!
ACCOUNT_B_EMAIL=aqa-account-b@example.com
ACCOUNT_B_PASSWORD=Passw0rd123!
ACCOUNT_UI_EMAIL=aqa-account-ui@example.com
ACCOUNT_UI_PASSWORD=Passw0rd123!
# Read-only smoke account (provisioned automatically; never mutated by tests).
SMOKE_EMAIL=test@test.test
SMOKE_PASSWORD=12345678

# Log verbosity for the console logger: all | trace | debug | info | warn | error
LOG_LEVEL=info

# Number of parallel Playwright workers. Remove to use Playwright's default
# (half the CPU cores). UI tests share one account, so keep this low.
WORKERS_AMOUNT=2
