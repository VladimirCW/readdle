{
  "name": "readdle",
  "version": "1.0.0",
  "description": "Playwright smoke tests",
  "scripts": {
    "test": "npm run test:api && npm run test:e2e",
    "test:all": "playwright test src/tests/api src/tests/ui",
    "test:api": "playwright test src/tests/api",
    "test:e2e": "playwright test src/tests/ui",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint -c .eslintrc.json --ext .ts src --cache",
    "lintFix": "eslint -c .eslintrc.json --ext .ts src --cache --fix",
    "docker:build": "docker build -t readdle-tests .",
    "docker:test": "docker run --rm readdle-tests",
    "docker:test:api": "docker run --rm readdle-tests test:api",
    "docker:test:e2e": "docker run --rm readdle-tests test:e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "20.8.10",
    "@typescript-eslint/eslint-plugin": "6.10.0",
    "@typescript-eslint/parser": "6.10.0",
    "axios": "1.18.1",
    "dotenv": "16.3.1",
    "eslint": "8.53.0",
    "eslint-plugin-import": "2.29.0",
    "log4js": "6.9.1",
    "prettier": "3.2.5",
    "typescript": "5.3.3"
  }
}
